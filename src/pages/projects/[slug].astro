---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Picture from '../../components/Picture.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import CTA from '../../components/CTA.astro';
import Icon from '../../components/Icon.astro';
import { projects, videos } from '../../data/projects';
import { services } from '../../data/services';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const service = services.find((s) => s.slug === project.service)!;
const video = videos.find((v) => v.id === project.video);
---
<Layout title={project.title} description={`${project.description} A work record from M.M. Construction & Consults, ${project.location}.`}>
  <PageHero label={project.title} title={project.title} text={project.description} image={project.image} alt={project.alt} parent="Projects" parentHref="/projects" />

  <section class="section">
    <div class="container content-grid">
      <div class="prose reveal">
        <p class="eyebrow">{project.category}</p>
        <h2>About this work record.</h2>
        <p>{project.description}</p>
        <p>These photographs and clips come directly from M.M. Construction &amp; Consults sites and give a first-hand view of site conditions and the work carried out.</p>
        <p class="project-location"><Icon name="map-pin" size={16} />{project.location}</p>
        <div class="project-note">{project.note}</div>
      </div>
      <aside class="content-aside">
        <h2>Related service</h2>
        <p>{service.title} — {service.short}</p>
        <a href={`/services/${service.slug}`}>Explore the service <Icon name="arrow-right" size={16} /></a>
        <a class="button" href={`/contact?service=${encodeURIComponent(service.title)}`}>Discuss your project <Icon name="arrow-right" size={17} /></a>
      </aside>
    </div>
  </section>

  <section class="section light">
    <div class="container">
      <SectionHeading label="Project photographs" title="A closer view of the work." />
      <div class="gallery-grid">
        {project.gallery.map((src, i) => (
          <figure class="lift-card reveal">
            <div class="card-image"><Picture src={src} alt={i === 0 ? project.alt : `${project.title} — site record ${i + 1}`} /></div>
            <figcaption>Site record · {project.title}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  {video && (
    <section class="section">
      <div class="container">
        <SectionHeading label="Site footage" title={video.title} />
        <video class="video-detail portrait" controls preload="none" playsinline poster={video.poster} aria-label={video.title}>
          <source src={`/videos/selected/${video.id}.mp4`} type="video/mp4" />
          Your browser does not support this video. <a href={`/videos/selected/${video.id}.mp4`}>Open the MP4.</a>
        </video>
        <p class="video-note">{video.description}</p>
      </div>
    </section>
  )}

  <section class="section light">
    <div class="container">
      <SectionHeading label="More work" title="Other projects." href="/projects" link="Back to all projects" />
      <ProjectGrid filters={false} limit={4} />
    </div>
  </section>
  <CTA />
</Layout>
