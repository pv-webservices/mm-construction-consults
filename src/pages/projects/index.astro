---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import VideoGrid from '../../components/VideoGrid.astro';
import CTA from '../../components/CTA.astro';
---
<Layout title="Projects & Our Work" description="Society repair, rehabilitation and repainting projects by M.M. Construction & Consults in Dadar, Ghatkopar, Mazgaon, Chembur, Oshiwara, Thane and Virar — with project values, scope and site photographs.">
  <PageHero label="Projects" title="Work you can see.<br/>Details that matter." text="Housing societies and buildings we have repaired, rehabilitated and repainted across Mumbai, Thane and Virar, with project values from ₹20 lakh to ₹1.5 crore." image="/images/optimized/scaffold.webp" alt="Residential building under repair with scaffolding" />

  <section class="section">
    <div class="container">
      <SectionHeading label="Recent projects" title="A closer look at our sites." text="Filter by type of work. Open a project to see its location, project value, scope of work, photographs and footage." />
      <ProjectGrid />
    </div>
  </section>

  <section class="section light">
    <div class="container">
      <SectionHeading label="Site execution" title="See the work in progress." href="/videos" link="All videos" />
      <VideoGrid limit={4} />
    </div>
  </section>
  <CTA />
</Layout>
