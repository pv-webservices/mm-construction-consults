---
import type { Video } from '../data/projects';
import Icon from './Icon.astro';
import Picture from './Picture.astro';

interface Props { video: Video; featured?: boolean; showText?: boolean; headingLevel?: 2 | 3 }
const { video, featured = false, showText = true, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---
<a
  class:list={['video-card', 'lift-card', 'reveal', { featured, landscape: video.landscape }]}
  href={`/videos/${video.id}/`}
  data-video={`/videos/selected/${video.id}.mp4`}
  data-title={video.title}
  data-landscape={video.landscape ? 'true' : undefined}
>
  <div class="video-poster">
    <Picture src={video.poster} alt={`Still from the video: ${video.title}`} sizes={featured ? '(max-width: 900px) 100vw, 60vw' : '(max-width: 640px) 100vw, 25vw'} />
    <span class="play" aria-hidden="true"><Icon name="play" size={featured ? 30 : 22} /></span>
    <span class="video-tag">{video.category}</span>
    <span class="video-duration">{video.duration}</span>
  </div>
  <div class="video-copy">
    <Heading>{video.title}</Heading>
    {showText && <p>{video.description}</p>}
    <span class="video-cta">Watch video <Icon name="arrow-right" size={15} /></span>
  </div>
</a>
