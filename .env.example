# Copy to .env for local use only. NEVER commit real values.
# On Netlify these are set in: Site configuration > Environment variables (scope must include Functions).
# See docs/EMAIL-SETUP.md.

# Optional: canonical origin. Defaults to https://mmconstructionconsults.com (astro.config.mjs).
PUBLIC_SITE_URL=

# Contact form email (Hostinger mailbox). Host and port are not secret; user/password are.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=info@mmconstructionconsults.com
MAIL_FROM=info@mmconstructionconsults.com

# Optional: extra comma-separated origins allowed to post the form (e.g. a staging domain).
ALLOWED_ORIGINS=
