---
import '../styles/global.css';
import '@fontsource/montserrat/latin-600.css';
import '@fontsource/montserrat/latin-700.css';
import '@fontsource/montserrat/latin-800.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
// Same hashed files the @fontsource CSS references: body text and the H1 weight are preloaded.
import interRegular from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import montserratHeavy from '@fontsource/montserrat/files/montserrat-latin-800-normal.woff2?url';
import { site, navigation, certificate } from '../data/site';
import { services } from '../data/services';
import { pageTitle, jsonLd, absolute, ids } from '../lib/seo';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description: string;
  /** Utility pages (404, thank-you, HTML sitemap): noindex, no canonical, not in the XML sitemap. */
  noindex?: boolean;
  /** Social-sharing image; defaults to the 1200×630 brand image. */
  image?: { src: string; width: number; height: number; alt: string };
  ogType?: 'website' | 'article';
}
const { title, description, noindex = false, image = site.ogImage, ogType = 'website' } = Astro.props;
// Netlify sets CONTEXT at build time; deploy previews and branch deploys must never be indexed.
const isPreviewBuild = ['deploy-preview', 'branch-deploy'].includes(process.env.CONTEXT ?? '');
const indexable = !noindex && !isPreviewBuild;
const fullTitle = pageTitle(title);
const pathname = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
const canonical = absolute(pathname);
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'GeneralContractor',
      '@id': ids.organization,
      name: site.name,
      url: `${site.url}/`,
      logo: { '@type': 'ImageObject', url: absolute(site.logo), width: 240, height: 151 },
      image: absolute(site.ogImage.src),
      telephone: '+919768737810',
      email: site.email,
      address: { '@type': 'PostalAddress', streetAddress: site.streetAddress, addressLocality: site.locality, addressRegion: 'Maharashtra', postalCode: site.postalCode, addressCountry: 'IN' },
      foundingDate: String(site.foundedYear),
      hasCredential: { '@type': 'EducationalOccupationalCredential', name: `${certificate.standard} ${certificate.title}`, credentialCategory: 'certification' },
      areaServed: site.serviceArea,
      sameAs: [site.instagram, site.facebook],
      founder: { '@id': ids.founder },
    },
    { '@type': 'WebSite', '@id': ids.website, url: `${site.url}/`, name: site.name, inLanguage: 'en-IN', publisher: { '@id': ids.organization } },
    { '@type': 'Person', '@id': ids.founder, name: site.founder, jobTitle: 'Founder, Structural Consultant & Contractor', worksFor: { '@id': ids.organization } },
  ],
};
const quickLinks = navigation.filter((n) => n.href !== '/contact/');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : 'noindex, follow'} />
  {indexable && <link rel="canonical" href={canonical} />}
  <link rel="preload" href={interRegular} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={montserratHeavy} as="font" type="font/woff2" crossorigin />
  <meta name="theme-color" content="#0b2545" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:locale" content="en_IN" />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={absolute(image.src)} />
  <meta property="og:image:width" content={String(image.width)} />
  <meta property="og:image:height" content={String(image.height)} />
  <meta property="og:image:alt" content={image.alt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={absolute(image.src)} />
  <meta name="twitter:image:alt" content={image.alt} />
  <script type="application/ld+json" set:html={jsonLd(graph)} />
  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <div class="topbar">
    <div class="container topbar-inner">
      <ul class="topbar-contact">
        <li><a href={site.phones[0].href}><Icon name="phone" size={14} />{site.phones[0].label}</a></li>
        <li class="topbar-hide-sm"><a href={site.phones[1].href}><Icon name="phone" size={14} />{site.phones[1].label}</a></li>
        <li class="topbar-hide-md"><a href={`mailto:${site.email}`}><Icon name="mail" size={14} />{site.email}</a></li>
        <li class="topbar-hide-lg"><Icon name="map-pin" size={14} />{site.addressShort}</li>
      </ul>
      <div class="topbar-social">
        <span class="topbar-hide-sm">Follow us</span>
        <a href={site.instagram} aria-label="Instagram" target="_blank" rel="noopener noreferrer"><Icon name="instagram" size={15} /></a>
        <a href={site.facebook} aria-label="Facebook" target="_blank" rel="noopener noreferrer"><Icon name="facebook" size={15} /></a>
        <a href={`https://wa.me/${site.whatsapp}`} aria-label="WhatsApp" target="_blank" rel="noopener noreferrer"><Icon name="message-circle" size={15} /></a>
      </div>
    </div>
  </div>

  <header class="header">
    <div class="container header-inner">
      <a href="/" class="brand" aria-label="M.M. Construction & Consults — home">
        <img src="/images/brand/logo-160.webp" srcset="/images/brand/logo-160.webp 1x, /images/brand/logo.webp 2x" alt="" width="160" height="101" />
        <span class="brand-text">
          <strong>M.M. Construction</strong>
          <strong class="brand-sub">&amp; Consults</strong>
          <small>{site.tagline}</small>
        </span>
      </a>
      <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="main-nav">
        <span></span><span></span><span></span>
      </button>
      <nav id="main-nav" class="main-nav" aria-label="Main navigation">
        <ul>
          {navigation.map((item) => (
            <li class:list={{ 'has-menu': item.children }}>
              <a href={item.href} class:list={{ active: isActive(item.href) }} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.name}
                {item.children && <Icon name="chevron-down" size={15} class="nav-caret" />}
              </a>
              {item.children && (
                <>
                  <button class="submenu-toggle" type="button" aria-label="Show services" aria-expanded="false"><Icon name="chevron-down" size={18} /></button>
                  <div class="submenu">
                    <ul>
                      {services.map((s) => (
                        <li><a href={`/services/${s.slug}/`}><Icon name={s.icon} size={18} />{s.title}</a></li>
                      ))}
                    </ul>
                    <a class="submenu-all" href="/services/">View all services <Icon name="arrow-right" size={15} /></a>
                  </div>
                </>
              )}
            </li>
          ))}
        </ul>
        <a href="/contact/" class="button nav-quote">Get a Free Quote <Icon name="arrow-right" size={16} /></a>
        <a class="mobile-phone" href={site.phones[0].href}><Icon name="phone" size={17} /> Call {site.phones[0].label}</a>
      </nav>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="footer">
    <div class="container footer-grid">
      <div class="footer-brand">
        <a href="/" class="brand">
          <img src="/images/brand/logo-160.webp" srcset="/images/brand/logo-160.webp 1x, /images/brand/logo.webp 2x" alt="" width="160" height="101" loading="lazy" />
          <span class="brand-text">
            <strong>M.M. Construction</strong>
            <strong class="brand-sub">&amp; Consults</strong>
            <small>{site.tagline}</small>
          </span>
        </a>
        <p>Civil repair, structural rehabilitation, NDT and waterproofing for residential, commercial and industrial buildings across {site.serviceArea}.</p>
      </div>
      <div>
        <h2>Quick Links</h2>
        <ul>{quickLinks.map((n) => <li><a href={n.href}>{n.name}</a></li>)}</ul>
      </div>
      <div>
        <h2>Our Services</h2>
        <ul>{services.map((s) => <li><a href={`/services/${s.slug}/`}>{s.title}</a></li>)}</ul>
      </div>
      <div class="footer-contact">
        <h2>Contact Us</h2>
        <ul>
          <li><Icon name="phone" size={18} /><span>{site.phones.map((p) => <a href={p.href}>{p.label}</a>)}</span></li>
          <li><Icon name="map-pin" size={18} /><span>{site.address}</span></li>
          <li><Icon name="mail" size={18} /><span>{site.emails.map((e) => <a href={`mailto:${e}`}>{e}</a>)}</span></li>
        </ul>
      </div>
      <div>
        <h2>Follow Us</h2>
        <div class="social-links">
          <a href={site.instagram} aria-label="Follow us on Instagram" target="_blank" rel="noopener noreferrer"><Icon name="instagram" size={20} /></a>
          <a href={site.facebook} aria-label="Follow us on Facebook" target="_blank" rel="noopener noreferrer"><Icon name="facebook" size={20} /></a>
          <a href={`https://wa.me/${site.whatsapp}`} aria-label="Chat on WhatsApp" target="_blank" rel="noopener noreferrer"><Icon name="message-circle" size={20} /></a>
        </div>
        <a class="button small footer-quote" href="/contact/">Get a Free Quote <Icon name="arrow-right" size={15} /></a>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="container">
        <p>© {new Date().getFullYear()} M.M. Construction &amp; Consults. All rights reserved.</p>
        <div>
          <a href="/privacy-policy/">Privacy Policy</a>
          <a href="/terms-conditions/">Terms &amp; Conditions</a>
          <a href="/sitemap/">Sitemap</a>
        </div>
      </div>
    </div>
  </footer>

  <a class="whatsapp-float" href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hello, I would like to enquire about construction and structural services.')}`} aria-label="Enquire on WhatsApp" target="_blank" rel="noopener noreferrer">
    <svg viewBox="0 0 24 24" width="30" height="30" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.79h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88m8.41-18.3A11.81 11.81 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.16-3.48-8.41"/></svg>
  </a>
  <button class="to-top" type="button" aria-label="Back to top"><Icon name="arrow-up-right" size={18} /></button>

  <dialog id="video-modal" aria-labelledby="video-modal-title">
    <div class="modal-heading">
      <h2 id="video-modal-title">Site video</h2>
      <button class="modal-close" type="button" aria-label="Close video"><Icon name="x" size={22} /></button>
    </div>
    <video controls preload="none" playsinline aria-label="Selected video"></video>
  </dialog>

  <script src="../scripts/site.ts"></script>
</body>
</html>
