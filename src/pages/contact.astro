---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { ENDPOINT, HONEYPOT_FIELD, RULES } from '../lib/enquiry';

const mapQuery = encodeURIComponent(site.mapQuery);
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${mapQuery}`;
const pageUrl = new URL('/contact/', site.url).href;
---
<Layout title="Contact & Request a Free Quote" description="Call +91 97687 37810, email info@mmconstructionconsults.com or send the form for a free quote on structural repair, NDT or waterproofing. Office: Ghatkopar West, Mumbai.">
  <PageHero label="Contact us" title="Let’s talk about<br/>your building." text="Share your concern, ask about a service, or request a free quote." image="/images/projects/himgiri-sai-shyam-chs-1.webp" />

  <section class="section light">
    <div class="container contact-grid">
      <div class="contact-info">
        <h2 class="eyebrow">Speak to our team</h2>
        <div class="contact-card lift-card">
          <Icon name="phone" size={24} />
          <div><h3>Call us</h3>{site.phones.map((p) => <a href={p.href}>{p.label}</a>)}</div>
        </div>
        <div class="contact-card lift-card">
          <Icon name="message-circle" size={24} />
          <div><h3>WhatsApp</h3><a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">{site.phones[0].label}</a></div>
        </div>
        <div class="contact-card lift-card">
          <Icon name="mail" size={24} />
          <div><h3>Email</h3>{site.emails.map((e) => <a href={`mailto:${e}`}>{e}</a>)}</div>
        </div>
        <div class="contact-card lift-card">
          <Icon name="map-pin" size={24} />
          <div>
            <h3>Office</h3><p>{site.address}</p><p>Serving {site.serviceArea}</p>
            <a class="text-link directions-link" href={directionsUrl} target="_blank" rel="noopener noreferrer">Get directions <Icon name="navigation" size={15} /></a>
          </div>
        </div>
        <div class="social-links contact-social">
          <a href={site.instagram} aria-label="Instagram" target="_blank" rel="noopener noreferrer"><Icon name="instagram" size={20} /></a>
          <a href={site.facebook} aria-label="Facebook" target="_blank" rel="noopener noreferrer"><Icon name="facebook" size={20} /></a>
        </div>
      </div>

      <div class="form-panel">
        <h2>Request a free quote</h2>
        <p>Your enquiry is emailed straight to our team. Prefer WhatsApp? Use the WhatsApp button instead. Fields marked * are required.</p>
        <!-- Works without JavaScript (normal POST, 303 to /thank-you/). With JavaScript it validates inline and sends in the background. -->
        <form id="enquiry-form" method="post" action={ENDPOINT} data-whatsapp={site.whatsapp}>
          <div class="hp-field" aria-hidden="true">
            <label for={HONEYPOT_FIELD}>Leave this field empty</label>
            <input type="text" id={HONEYPOT_FIELD} name={HONEYPOT_FIELD} tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="form_started" value="" />
          <input type="hidden" name="form_type" value="Quote request (contact page)" />
          <input type="hidden" name="page" value={pageUrl} />
          <div id="form-summary" class="form-summary" role="alert" tabindex="-1" hidden></div>
          <div class="form-grid">
            <div class="field">
              <label for="name">Your name *</label>
              <input id="name" name="name" autocomplete="name" required minlength={RULES.name.min} maxlength={RULES.name.max} aria-describedby="name-error" />
              <p id="name-error" class="field-error" hidden></p>
            </div>
            <div class="field">
              <label for="phone">Phone / WhatsApp number *</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required maxlength={RULES.phone.max} pattern="[+0-9 ().\-]{10,20}" placeholder="+91 98765 43210" aria-describedby="phone-hint phone-error" />
              <small id="phone-hint">10 to 15 digits, with country code if outside India.</small>
              <p id="phone-error" class="field-error" hidden></p>
            </div>
            <div class="field">
              <label for="email">Email *</label>
              <input id="email" name="email" type="email" autocomplete="email" required maxlength={RULES.email.max} placeholder="you@example.com" aria-describedby="email-error" />
              <p id="email-error" class="field-error" hidden></p>
            </div>
            <div class="field">
              <label for="service">Service required *</label>
              <select id="service" name="service" required aria-describedby="service-error">
                <option value="">Select a service</option>
                {services.map((s) => <option value={s.title}>{s.title}</option>)}
                <option value="Help choosing the right service">Help choosing the right service</option>
              </select>
              <p id="service-error" class="field-error" hidden></p>
            </div>
            <div class="field full">
              <label for="location">Project location <span>(optional)</span></label>
              <input id="location" name="location" autocomplete="address-level2" maxlength={RULES.location.max} placeholder="Area / city" aria-describedby="location-error" />
              <p id="location-error" class="field-error" hidden></p>
            </div>
            <div class="field full">
              <label for="message">Tell us about the project *</label>
              <textarea id="message" name="message" required minlength={RULES.message.min} maxlength={RULES.message.max} placeholder="Describe the concern, type of building, or work you need." aria-describedby="message-error"></textarea>
              <p id="message-error" class="field-error" hidden></p>
            </div>
            <div class="field full consent-field">
              <div class="consent-row">
                <input id="consent" name="consent" type="checkbox" required aria-describedby="consent-error" />
                <label for="consent">I agree that M.M. Construction &amp; Consults may use these details to reply to my enquiry, as described in the <a href="/privacy-policy/" class="text-link">Privacy Policy</a>. *</label>
              </div>
              <p id="consent-error" class="field-error" hidden></p>
            </div>
          </div>
          <div class="form-bottom">
            <button class="button" type="submit" data-submit>Send Enquiry <Icon name="send" size={18} /></button>
            <button class="button outline" type="button" data-whatsapp-send hidden>Send via WhatsApp <Icon name="message-circle" size={18} /></button>
          </div>
          <p id="enquiry-status" class="enquiry-status" role="status" aria-live="polite" hidden></p>
        </form>
        <div id="enquiry-result" class="enquiry-result" hidden tabindex="-1">
          <h3>Your WhatsApp enquiry is ready.</h3>
          <p>If WhatsApp did not open, use the button below. The message is delivered only after you tap Send in WhatsApp.</p>
          <pre id="enquiry-draft"></pre>
          <div class="button-row">
            <a id="open-whatsapp" class="button" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener noreferrer">Open WhatsApp <Icon name="arrow-right" size={17} /></a>
            <button type="button" class="button outline" data-copy-enquiry>Copy enquiry</button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="map-frame">
        <iframe title={`Map of our office: ${site.address}`} src={`https://www.google.com/maps?q=${mapQuery}&output=embed`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <div class="map-address">
        <p><Icon name="map-pin" size={18} /><span><strong>Our office</strong>{site.address}</span></p>
        <a class="button small" href={directionsUrl} target="_blank" rel="noopener noreferrer">Get directions <Icon name="navigation" size={15} /></a>
      </div>
    </div>
  </section>
  <script src="../scripts/enquiry-form.ts"></script>
</Layout>
