---
import manifest from '../data/media.json';

interface Props { src: string; alt: string; class?: string; eager?: boolean; sizes?: string }
const { src, alt, class: className, eager = false, sizes = '(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 33vw' } = Astro.props;

type Size = { width: number; height: number };
const media = manifest as Record<string, Size>;
const dimensions = media[src];
if (!dimensions) throw new Error(`Picture: ${src} is not in src/data/media.json (run npm run media).`);
// Smaller variants are written as name-<width>.webp next to the largest file, each with an .avif twin.
const base = src.replace(/\.webp$/, '');
const variants = Object.keys(media)
  .filter((key) => key === src || new RegExp(`^${base.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}-\\d+\\.webp$`).test(key))
  .sort((a, b) => media[a].width - media[b].width);
const srcset = (ext: string) => variants.map((key) => `${key.replace(/\.webp$/, ext)} ${media[key].width}w`).join(', ');
---
<picture>
  <source type="image/avif" srcset={srcset('.avif')} sizes={sizes} />
  <img
    src={src}
    srcset={srcset('.webp')}
    sizes={sizes}
    alt={alt}
    class={className}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding={eager ? undefined : 'async'}
    width={dimensions.width}
    height={dimensions.height}
  />
</picture>
