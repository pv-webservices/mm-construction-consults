---
import Picture from './Picture.astro';
import { breadcrumbSchema, jsonLd, type Crumb } from '../lib/seo';

// The hero photograph is a dimmed background behind the heading, so it is decorative (alt="").
interface Props { label: string; title: string; text: string; image?: string; parent?: string; parentHref?: string }
const {
  label, title, text,
  image = '/images/projects/kapil-ratna-chs-1.webp',
  parent, parentHref,
} = Astro.props;
const headingLines = title.split(/<br\s*\/?>/);
const crumbs: Crumb[] = [
  { name: 'Home', path: '/' },
  ...(parent && parentHref ? [{ name: parent, path: parentHref }] : []),
  { name: label, path: Astro.url.pathname },
];
---
<script type="application/ld+json" set:html={jsonLd(breadcrumbSchema(crumbs))} />
<section class="page-hero">
  <div class="page-hero-bg">
    <Picture src={image} alt="" eager={true} sizes="100vw" />
  </div>
  <div class="container page-hero-inner">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span>
      {parent && <><a href={parentHref}>{parent}</a><span aria-hidden="true">/</span></>}
      <span aria-current="page">{label}</span>
    </nav>
    <h1>{headingLines.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h1>
    <p class="page-lead">{text}</p>
  </div>
</section>
